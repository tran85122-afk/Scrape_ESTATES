# Chép file này thành .env (cùng thư mục) rồi thay MAT_KHAU bằng mật khẩu của user "scraper".
# File .env đã nằm trong .gitignore, KHÔNG đưa lên git.

# Database chính (scraper + giao diện ghi/đọc ở đây)
DATABASE_URL=postgresql://scraper:MAT_KHAU@localhost:5433/bds

# (Không bắt buộc) database riêng cho bộ test: mỗi test tạo rồi xóa một schema tạm trong đó
TEST_DATABASE_URL=postgresql://scraper:MAT_KHAU@localhost:5433/bds_test
